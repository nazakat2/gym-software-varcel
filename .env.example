# ═══════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/gym_db

# ═══════════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ═══════════════════════════════════════════════════════════════════════════
# Authentication & Security
# ═══════════════════════════════════════════════════════════════════════════

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration (e.g., "7d", "24h", "30m")
JWT_EXPIRES_IN=7d

# Bcrypt rounds (10-12 recommended for production)
BCRYPT_ROUNDS=10

# ═══════════════════════════════════════════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ═══════════════════════════════════════════════════════════════════════════
# Redis (Optional - for rate limiting & caching)
# ═══════════════════════════════════════════════════════════════════════════

# Redis connection string (leave empty to use in-memory store)
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════
# File Storage (Vercel Blob)
# ═══════════════════════════════════════════════════════════════════════════

# Vercel Blob token (for photo uploads)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# ═══════════════════════════════════════════════════════════════════════════
# Email Configuration (Required for OTP verification)
# ═══════════════════════════════════════════════════════════════════════════

# SMTP settings for sending emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Email sender (will use SMTP_USER if not set)
EMAIL_FROM=noreply@yourgym.com
SUPPORT_EMAIL=support@yourgym.com

# ═══════════════════════════════════════════════════════════════════════════
# SMS Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Twilio credentials (for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════════════════
# Payment Gateway (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Stripe keys (for online payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ═══════════════════════════════════════════════════════════════════════════
# Monitoring & Logging (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Sentry DSN (for error tracking)
SENTRY_DSN=https://...@sentry.io/...

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════════════════════════

# Enable/disable features
ENABLE_BRANCHES=false
ENABLE_ONLINE_PAYMENTS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true

# ═══════════════════════════════════════════════════════════════════════════
# Super Admin (Initial Setup)
# ═══════════════════════════════════════════════════════════════════════════

# Super admin credentials (for first-time setup)
SUPER_ADMIN_EMAIL=admin@yourgym.com
SUPER_ADMIN_PASSWORD=change-this-password
SUPER_ADMIN_NAME=Super Admin
